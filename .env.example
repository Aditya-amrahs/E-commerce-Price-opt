# Prefer SQL Server/Azure SQL-compatible local development.
# Example with Windows trusted connection:
# DATABASE_URL=mssql+pyodbc://localhost/olist_price_opt?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes&Trusted_Connection=yes
#
# Quick fallback for machines without SQL Server installed:
DATABASE_URL=sqlite:///artifacts/local_dev.db

RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
ARTIFACT_DIR=artifacts
MODEL_DIR=artifacts/models
FEATURE_STORE_PATH=artifacts/features/model_features.parquet
RANDOM_SEED=42
TEST_SIZE=0.2
VALIDATION_SIZE=0.2


# For Azure Static Web Apps set this to your deployed backend URL.
VITE_API_BASE_URL=https://backend.calmsea-8a56c76a.eastasia.azurecontainerapps.io
